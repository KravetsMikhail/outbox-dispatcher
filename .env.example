# Copy to .env or pass another file: -env=.env.local
# PostgreSQL
DATABASE_URL=postgres://user:pass@localhost:5432/dbname?sslmode=disable

# Base URL for POST (path comes from metadata.name or metadata.path)
POST_BASE_URL=https://api.example.com

# Schema and table for outbox (PostgreSQL). Queries use "OUTBOX_SCHEMA"."OUTBOX_TABLE".
OUTBOX_SCHEMA=public
OUTBOX_TABLE=outbox_messages
# Skip startup check that the table exists (dashboard still runs VerifyTable).
# OUTBOX_SKIP_VERIFY=false

# Retries: after each failed POST, retry_count increases; when it exceeds MAX_RETRY_ATTEMPTS, status=failed (0 = unlimited)
MAX_RETRY_ATTEMPTS=10
RETRY_BASE_INTERVAL=30s
TOKEN_RETRY_DELAY=30s

# Schedule: either SCHEDULE_INTERVAL (duration) OR SCHEDULE_CRON (5-field), not both.
# Override with flags: -schedule=30s or -cron="*/5 * * * *"
SCHEDULE_INTERVAL=30s
# SCHEDULE_CRON=*/1 * * * *

# Keycloak (client_credentials): either full token URL or base URL + realm
KEYCLOAK_BASE_URL=https://keycloak.example.com
KEYCLOAK_REALM=myrealm
# Optional: override computed .../protocol/openid-connect/token
# KEYCLOAK_TOKEN_URL=https://keycloak.example.com/realms/myrealm/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=outbox-dispatcher
KEYCLOAK_CLIENT_SECRET=your-client-secret

# Web dashboard (status, stats, errors). Default :8484. Set UI_DISABLE=true to turn off.
# UI_LISTEN_ADDR=:8484
# UI_DISABLE=false
